{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MARIELA PDV",
  "version": "0.1.0",
  "identifier": "com.mariela.pdv",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build:desktop",
    "devUrl": "http://localhost:8080",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "MARIELA PDV",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
