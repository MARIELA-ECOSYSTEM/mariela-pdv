# MARIELA PDV — variáveis de ambiente
# Copie este arquivo para .env.local (não versionado) e ajuste os valores.
# Nenhum segredo deve ser versionado. O PDV não possui banco próprio e nunca
# acessa MongoDB diretamente: ele apenas consome a API HTTP do mariela-backend.

# URL base do mariela-backend — SOMENTE a origem, sem barra final e SEM
# "/api/v1": o código já adiciona esse prefixo (e o de /pdv em seguida) a
# cada chamada. Colocar "/api/v1" aqui duplica o prefixo e quebra 100% das
# chamadas com 404.
#   Local:     VITE_API_URL=http://localhost:3000
#   Produção:  VITE_API_URL=https://mariela-backend.onrender.com
# ERRADO:      VITE_API_URL=https://mariela-backend.onrender.com/api/v1
VITE_API_URL=

# Fonte de dados da interface:
#   mock → dados locais de apresentação (padrão em desenvolvimento, usado enquanto a API não está ligada)
#   api  → mariela-backend real via HTTP (exige VITE_API_URL)
# Não há fallback silencioso: com "api", falhas são exibidas como erro.
# Para ligar a API real, use as duas linhas juntas, por exemplo:
#   VITE_API_URL=http://localhost:3000
#   VITE_PDV_DATA_SOURCE=api
#
# EM PRODUÇÃO (build com `vite build`, sem --mode development) esta variável
# É OBRIGATORIAMENTE "api" — se estiver ausente, "mock" ou qualquer outro
# valor, o aplicativo falha explicitamente na inicialização em vez de operar
# em mock por engano (ver src/config/pdv.config.ts, validarConfiguracaoProducao).
VITE_PDV_DATA_SOURCE=mock

